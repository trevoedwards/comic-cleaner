# Copy to .env (gitignored) and adjust.
#
# A folder of real comics to test against. Mounted READ-ONLY at /comics inside
# the Docker dev service.
#
# Linux (this machine):
CC_TEST_COMICS=/home/prime/Temp/PageMaster-Test-Content
# Windows:
# CC_TEST_COMICS=C:/Temp/PageMaster-Test-Content

# The container runs as this user so files it writes into the repo stay yours.
# Both default to 1000; set them to the output of `id -u` and `id -g` if yours
# differ.
# CC_UID=1000
# CC_GID=1000
